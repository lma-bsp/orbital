#!/bin/sh
#
# Generate the per-install infrastructure secrets into .env.
#
# The Compose stack refuses to start without these (docker-compose.yml
# uses ${VAR:?}), and nothing ships a default for them any more:
#
#   ASTERISK_AMI_SECRET   AMI login (Asterisk, Laravel, config-sync)
#   LIVEKIT_API_KEY       LiveKit key pair (LiveKit server, SIP bridge,
#   LIVEKIT_API_SECRET      Laravel, agent worker, webhook signatures)
#   REDIS_PASSWORD        Valkey requirepass and every client
#
# Like `php artisan key:generate`, it only fills values that are empty
# or missing, so it is safe to run on every install and every `make up`.
# Needs only a POSIX shell, so it works before PHP or any container is up.
#
# A value equal to one that used to be committed to docker/ (public, so
# burned) is replaced automatically, with a warning.
#
# Usage:
#   bin/orbital-secrets                    fill empty values
#   bin/orbital-secrets --rotate VAR...    regenerate the named values
#   bin/orbital-secrets --rotate-all       regenerate all four
#   ORBITAL_ENV_FILE=path bin/orbital-secrets   use another env file
#
# After rotating, restart the stack (`make down && make up`) so every
# container picks up the new values together.
#
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ENV_FILE=${ORBITAL_ENV_FILE:-$ROOT/.env}
MANAGED="ASTERISK_AMI_SECRET LIVEKIT_API_KEY LIVEKIT_API_SECRET REDIS_PASSWORD"

# SHA-256 of the values once committed in docker/asterisk/manager.conf
# and docker/livekit/*.yaml (hashes, so the literals stay out of the tree).
BURNED="
ASTERISK_AMI_SECRET 918493c2bd7f85ed3109adf87fec92460ee84694230625b1a311c3f5271517d4
LIVEKIT_API_KEY c7ab4d29e6d196a3e82247cdf767ed698342cd55676eac314a6572ecff7e3608
LIVEKIT_API_SECRET 4fddc81877e6cb752b42c127559bca1a4456c5af04737d097ab9697092c46bc5
REDIS_PASSWORD 00674b3ae19c56019f797c5b91ddee0c3f7f1d40a22311a2f869bf7fce3491da
"

say() { printf '[orbital-secrets] %s\n' "$*"; }
die() { printf '[orbital-secrets] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
    sed -n '/^# Usage:/,/^# After/p' "$0" | sed 's/^# \{0,1\}//' | sed '$d'
}

ROTATE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --rotate)
            shift
            [ $# -gt 0 ] || die "--rotate needs at least one variable name"
            while [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; do
                case " $MANAGED " in
                    *" $1 "*) ROTATE="$ROTATE $1" ;;
                    *) die "unknown variable '$1' (managed: $MANAGED)" ;;
                esac
                shift
            done
            continue
            ;;
        --rotate-all) ROTATE=" $MANAGED" ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

hex() {
    # $1 = number of random bytes; prints 2*$1 lowercase hex chars.
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex "$1"
    else
        od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'
        echo
    fi
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | cut -d' ' -f1
    else
        printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1
    fi
}

# Current value of $1 in the env file (last assignment wins, as in
# phpdotenv and Compose), with surrounding quotes stripped.
current() {
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$ENV_FILE" | tail -n 1 \
        | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

is_burned() {
    h=$(sha256 "$2")
    printf '%s\n' "$BURNED" | grep -qx "$1 $h"
}

# Replace every `VAR=` line, or append one if there is none.
set_value() {
    tmp="$ENV_FILE.orbital-secrets.$$"
    if grep -q "^[[:space:]]*$1[[:space:]]*=" "$ENV_FILE"; then
        awk -v k="$1" -v v="$2" '
            $0 ~ "^[[:space:]]*" k "[[:space:]]*=" { print k "=" v; next }
            { print }
        ' "$ENV_FILE" > "$tmp"
    else
        cat "$ENV_FILE" > "$tmp"
        [ -z "$(tail -c 1 "$ENV_FILE")" ] || echo >> "$tmp"
        printf '%s=%s\n' "$1" "$2" >> "$tmp"
    fi
    # cat over the original keeps its owner and mode (.env may be 0600).
    cat "$tmp" > "$ENV_FILE"
    rm -f "$tmp"
}

generate() {
    case "$1" in
        ASTERISK_AMI_SECRET) hex 24 ;;
        # LiveKit keys are conventionally API-prefixed; the secret must
        # be at least 32 characters.
        LIVEKIT_API_KEY) printf 'API%s\n' "$(hex 6)" ;;
        LIVEKIT_API_SECRET) hex 32 ;;
        REDIS_PASSWORD) hex 24 ;;
    esac
}

if [ ! -f "$ENV_FILE" ]; then
    [ -f "$ROOT/.env.example" ] || die "$ENV_FILE does not exist and there is no .env.example to copy"
    cp "$ROOT/.env.example" "$ENV_FILE"
    say "created $ENV_FILE from .env.example"
fi
[ -w "$ENV_FILE" ] || die "$ENV_FILE is not writable"

# The LiveKit pair moves together: rotating one half rotates both.
pair_why=""
case "$ROTATE" in *LIVEKIT_API_*) pair_why="rotated with its pair" ;; esac
for v in LIVEKIT_API_KEY LIVEKIT_API_SECRET; do
    val=$(current "$v")
    if [ -n "$val" ] && is_burned "$v" "$val"; then
        pair_why="replaced the public pair that used to be committed"
    fi
done

changed=""
for v in $MANAGED; do
    val=$(current "$v")
    why=""
    case " $ROTATE " in *" $v "*) why="rotated" ;; esac
    if [ -z "$why" ]; then
        case "$v" in
            LIVEKIT_API_*) why=$pair_why ;;
            *) if [ -n "$val" ] && is_burned "$v" "$val"; then why="replaced the public value that used to be committed"; fi ;;
        esac
    fi
    [ -n "$why" ] || [ -z "$val" ] || continue
    [ -n "$why" ] || why="generated"
    set_value "$v" "$(generate "$v")"
    say "$v: $why"
    changed="$changed $v"
done

if [ -z "$changed" ]; then
    say "all infrastructure secrets already set in $ENV_FILE"
else
    say "wrote$changed to $ENV_FILE"
    say "restart the whole stack so every container sees the same values: make down && make up"
fi
